## Application variables.
APP_NAME=Devflow
APP_ENV=development
APP_KEY=
# Preserve this value across upgrades; setup generates it only before installation.
APP_SALT=
APP_DEBUG=true
# Filled with the absolute project path by `composer setup-environment`.
APP_BASE_PATH=
APP_BASE_URL=http://localhost:8080/

AUTH_LOGIN_ROUTE=login

## Cookies: enable secure cookies when deploying with HTTPS.
COOKIE_SECURE=false
COOKIE_DOMAIN=''
COOKIE_PATH=/
COOKIE_SAMESITE=lax

## Devflow variables.
CMS_MAIN_SITE_ID=
## Used to append to subdomain when site is created.
CMS_MAIN_SITE_URL=
CMS_MAIN_SITE_PATH=/

## Mailer configuration
MAILER_DSN=smtp://localhost
MAILER_SMTP_DSN=smtp://localhost
MAILER_SENDMAIL_DSN=sendmail://default
MAILER_QMAIL_DSN="sendmail://default?command=/usr/sbin/qmail-inject"
MAILER_TRANSACTIONAL_DSN=postmark+api://KEY@default
MAILER_DEBUG=false
MAILER_EML_FILE=storage/mail/debug.eml
MAILER_FROM_EMAIL=no-reply@example.com
MAILER_FROM_NAME="${APP_NAME}"

## Database setup.
DB_CONNECTION=sqlite
DB_DSN="sqlite:${APP_BASE_PATH}/database/devflow.sqlite"
DB_COLLATION=utf8mb4_unicode_ci
DB_TABLE_PREFIX=cms_
DB_PERSISTENT=false
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root

## Redis Setup
REDIS_PREFIX=
REDIS_PERSISTENT=false
REDIS_SCHEME=tcp
REDIS_HOST=127.0.0.1
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_MAX_RETRIES=5
REDIS_DB=5
REDIS_CACHE_DB=0

## Amazon S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=

## Logger email setup.
LOGGER_EMAIL_SUBJECT="[System Error] Logger"
# LOGGER_FROM_EMAIL="${MAILER_FROM_EMAIL}"
# LOGGER_TO_EMAIL=alerts@example.com

## Firewall
FIREWALL_SLACK_WEBHOOK=
FIREWALL_ALERT_EMAIL=
